# Server Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/hunarhub

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary (optional - app works without these in development)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Demo Admin Account
ADMIN_EMAIL=admin@hunarhub.local
ADMIN_PASSWORD=Admin@12345

# Demo Customer Account
CUSTOMER_EMAIL=customer@hunarhub.local
CUSTOMER_PASSWORD=Customer@12345

# Demo Entrepreneur Account
ENTREPRENEUR_EMAIL=entrepreneur@hunarhub.local
ENTREPRENEUR_PASSWORD=Entrepreneur@12345
